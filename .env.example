TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_TOKEN

# Google Sheets (optional)
GOOGLE_CREDS_PATH=/run/creds/credentials.json
PRIMARY_SPREADSHEET_ID=sheet_id_1
SECOND_SPREADSHEET_ID=sheet_id_2

# Webhooks
ZAPIER_UPLOAD_HOOK=https://example.com/hook
ZAPIER_SECRET=CHANGE_ME
EXPENSE_WEBHOOK_URL=http://localhost:5009/expense-requests-webhook
EXPENSE_WEBHOOK_SECRET=CHANGE_ME
EXPENSE_STATUS_WEBHOOK=https://example.com/status

# TRON
TRON_API_KEY=TEST_KEY
TRON_CONTRACT_USDT=Txxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRON_WALLETS=

# Remote DB / SFTP (disabled in demo)
REMOTE_DB_HOST=127.0.0.1
REMOTE_DB_PORT=3306
REMOTE_DB_USER=user
REMOTE_DB_PASS=pass
REMOTE_DB_NAME=db
SFTP_HOST=127.0.0.1
SFTP_USER=user
SFTP_KEY=/run/creds/id_rsa
REMOTE_FILES_ROOT=/tmp/files
